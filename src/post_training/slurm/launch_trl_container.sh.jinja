#!/bin/bash
# ============================================================================
# Auto-generated containerized TRL launch script — do not edit by hand.
# Re-generate via: python scripts/render_launch_script.py --run-dir {{ run_dir }}
#
# This script starts the training processes of ONE node. Run it in an srun step
# that has one task for each node:
#
#     srun --nodes=N --ntasks=N --ntasks-per-node=1 bash {{ run_dir }}/slurm/launch.sh
#
# The step can be a part of a larger allocation that an external orchestrator
# owns (for example an oellm-autoexp pool). Thus the script:
#   - reads only the SLURM_STEP_* variables. SLURM_JOB_NODELIST and SLURM_NNODES
#     describe the full allocation, not this step.
#   - has no #SBATCH header, no requeue and no resubmission. The caller owns the
#     allocation and the restarts. A restart continues from the last checkpoint.
# ============================================================================

set -euo pipefail

: "${SLURM_STEP_NUM_NODES:?launch.sh must run in an srun step (one task for each node)}"

# The gradient accumulation and the checkpoints are valid for one world size only.
EXPECTED_NODES={{ num_nodes }}
if [ "$SLURM_STEP_NUM_NODES" -ne "$EXPECTED_NODES" ]; then
    echo "launch.sh: the step has $SLURM_STEP_NUM_NODES node(s), but the config expects $EXPECTED_NODES." >&2
    exit 1
fi

# The owner of the allocation can be a different Unix user. Keep the new files
# writable for the group.
umask 002

{% if modules %}
# ── Environment modules ────────────────────────────────────────────────────
{% if module_purge %}
module purge
{% endif %}
{% for mod in modules %}
module load {{ mod }}
{% endfor %}
{% endif %}

# ── Source cluster environment ────────────────────────────────────────────
{% if env_file %}source "{{ env_file }}"{% endif %}

# ── Distributed setup ─────────────────────────────────────────────────────
MASTER_ADDR=$(scontrol show hostnames "$SLURM_STEP_NODELIST" | head -n 1)
MASTER_ADDR=$(getent hosts "$MASTER_ADDR" | awk '{print $1}')
export MASTER_ADDR
# The step ID changes the port for each step of the same allocation.
export MASTER_PORT=$((29500 + (SLURM_JOB_ID + SLURM_STEP_ID) % 2000))
export GPUS_PER_NODE={{ gpus_per_node }}
export WORLD_SIZE=$(( SLURM_STEP_NUM_NODES * GPUS_PER_NODE ))

# NCCL tuning for multi-node stability
export NCCL_IB_TIMEOUT=120
export NCCL_DEBUG=WARN
# CUDA_DEVICE_MAX_CONNECTIONS=1 is a Megatron-LM tensor-parallel flag that
# serializes CUDA streams and hurts ZeRO-2 overlap_comm — the caller can have it set.
unset CUDA_DEVICE_MAX_CONNECTIONS
export OMP_NUM_THREADS=1

if [ "$SLURM_NODEID" -eq 0 ]; then
    echo "=========================================="
    echo "Step started at: $(date)"
    echo "Job ID: $SLURM_JOB_ID  Step ID: $SLURM_STEP_ID"
    echo "Nodes: $SLURM_STEP_NUM_NODES x $GPUS_PER_NODE GPUs (WORLD_SIZE=$WORLD_SIZE)"
    echo "Step nodes: $SLURM_STEP_NODELIST"
    echo "MASTER_ADDR:MASTER_PORT = ${MASTER_ADDR}:${MASTER_PORT}"
    echo "Config: {{ config_path }}"
    echo "Container: {{ container_image }}"
    echo "=========================================="
fi

# ── Launch inside Singularity container ───────────────────────────────────
exec singularity exec --nv \
{% for mount in bind_mounts %}  --bind "{{ mount }}" \
{% endfor %}  "{{ container_image }}" \
  bash -lc "
    set -e
    # A login shell can set the umask again.
    umask 002

    # Prevent host Python/PATH from interfering with container
    export PATH=\"{{ container_path }}\"
    export PYTHONPATH=\"{{ run_dir }}/src\"
    export PYTHONNOUSERSITE=1

    export NODE_RANK=\"\$SLURM_NODEID\"
    export NNODES=\"${SLURM_STEP_NUM_NODES}\"
    export NPROC_PER_NODE=${GPUS_PER_NODE}

    # Forward HF cache paths from host env (offline mode is controlled by train.py via config)
    export HF_HOME=${HF_HOME}
    export HF_HUB_CACHE=${HF_HUB_CACHE}
    export HUGGINGFACE_HUB_CACHE=${HUGGINGFACE_HUB_CACHE}
    export HF_DATASETS_CACHE=${HF_DATASETS_CACHE:-${HF_HOME}/datasets}
    export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

    cd \"{{ run_dir }}\"

    export WANDB_DIR=\"{{ run_dir }}\"

    accelerate launch \
      --num_machines \$NNODES \
      --num_processes $WORLD_SIZE \
      --machine_rank \$NODE_RANK \
      --main_process_ip $MASTER_ADDR \
      --main_process_port $MASTER_PORT \
      --mixed_precision {{ mixed_precision }} \
      --dynamo_backend {{ dynamo_backend }} \
{% if use_deepspeed -%}
      --use_deepspeed \
      --deepspeed_multinode_launcher {{ deepspeed_multinode_launcher }} \
{% endif -%}
{% if fsdp %}      --use_fsdp \
      --fsdp_version {{ fsdp.version }} \
{% if fsdp.version == 1 %}      --fsdp_sharding_strategy {{ fsdp.sharding_strategy }} \
      --fsdp_backward_prefetch {{ fsdp.backward_prefetch }} \
      --fsdp_forward_prefetch {{ fsdp.forward_prefetch | lower }} \
      --fsdp_use_orig_params {{ fsdp.use_orig_params | lower }} \
{% else %}      --fsdp_reshard_after_forward {{ 'true' if fsdp.sharding_strategy == 'FULL_SHARD' else 'false' }} \
{% endif %}      --fsdp_auto_wrap_policy {{ fsdp.auto_wrap_policy }} \
{% if fsdp.transformer_layer_cls_to_wrap %}      --fsdp_transformer_layer_cls_to_wrap {{ fsdp.transformer_layer_cls_to_wrap | join(",") }} \
{% endif %}{% if fsdp.min_num_params is not none %}      --fsdp_min_num_params {{ fsdp.min_num_params }} \
{% endif %}      --fsdp_state_dict_type {{ fsdp.state_dict_type }} \
      --fsdp_offload_params {{ fsdp.offload_params | lower }} \
      --fsdp_cpu_ram_efficient_loading {{ fsdp.cpu_ram_efficient_loading | lower }} \
      --fsdp_sync_module_states {{ fsdp.sync_module_states | lower }} \
      --fsdp_activation_checkpointing {{ fsdp.activation_checkpointing | lower }} \
{% endif -%}
{% if same_network %}      --same_network \
{% endif %}      --rdzv_backend {{ rdzv_backend }} \
      --max_restarts 0 \
      --role \$(hostname -s): \
      scripts/train.py --config {{ config_path }}{% if tokenize_only %} --tokenize-only{% endif %}
  "
